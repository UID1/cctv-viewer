#!/bin/bash
# Wrapper script to launch cctv-viewer with correct X11 environment
# This handles the dynamic XAUTHORITY path on KDE/Wayland systems

export DISPLAY="${DISPLAY:-:0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

# Find the X authority file dynamically
if [ -z "$XAUTHORITY" ]; then
    XAUTHORITY=$(ls /run/user/$(id -u)/xauth_* 2>/dev/null | head -1)
    if [ -n "$XAUTHORITY" ]; then
        export XAUTHORITY
    fi
fi

exec /usr/bin/cctv-viewer "$@"
