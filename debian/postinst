#!/bin/bash
set -e

case "$1" in
    configure)
        # Reload systemd to recognize the new service file
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
        fi

        echo ""
        echo "==================================================="
        echo " CCTV Viewer installation complete!"
        echo "==================================================="
        echo ""
        echo "To start CCTV Viewer manually:"
        echo "  cctv-viewer"
        echo ""
        echo "To enable as a systemd user service (starts at login):"
        echo "  systemctl --user enable cctv-viewer.service"
        echo "  systemctl --user start cctv-viewer.service"
        echo ""
        echo "To check service status:"
        echo "  systemctl --user status cctv-viewer.service"
        echo ""
        echo "To restart the service (e.g., from a desktop icon):"
        echo "  systemctl --user restart cctv-viewer.service"
        echo ""
        echo "Configuration is stored in:"
        echo "  ~/.config/CCTV Viewer/CCTV Viewer.conf"
        echo ""
        echo "To install a custom config file:"
        echo "  mkdir -p ~/.config/CCTV\\ Viewer"
        echo "  cp /usr/share/doc/cctv-viewer/examples/cctv-viewer.conf \\"
        echo "     ~/.config/CCTV\\ Viewer/CCTV\\ Viewer.conf"
        echo ""
        echo "==================================================="
        ;;
esac

#DEBHELPER#

exit 0
