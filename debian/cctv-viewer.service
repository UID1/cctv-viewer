[Unit]
Description=CCTV Viewer - Video Stream Display
Documentation=https://github.com/iEvgeny/cctv-viewer
After=graphical-session.target

[Service]
Type=simple

# Clean up stale lock files before starting
ExecStartPre=-/bin/rm -f %t/cctv-viewer-%U.lock
ExecStartPre=-/bin/rm -f /tmp/cctv-viewer-%U.lock

# Wait for display to be fully ready
ExecStartPre=/bin/sleep 2

# Return freed jemalloc pages about a second after free. The tripwire purge is the backstop.
Environment=MALLOC_CONF=dirty_decay_ms:1000,muzzy_decay_ms:1000

ExecStart=/usr/bin/cctv-viewer --full-screen --exit-on-memory-trip --memory-log

# Restart on crash or memory-tripwire exit (status 75)
Restart=on-failure
RestartSec=5

# Timeouts
TimeoutStartSec=30
TimeoutStopSec=10

# Resource limits
Nice=0

# Security hardening
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
